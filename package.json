{
  "name": "@raytrace-cli/cli",
  "version": "0.1.0",
  "description": "See what your coding agent did: traces, tool calls, cost and step-by-step evidence for Claude Code and Codex.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "raytrace": "bin/raytrace.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "proxy/",
    "worker/",
    "dist/dashboard/"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "vite build --config dashboard/vite.config.mjs",
    "dashboard:dev": "vite --config dashboard/vite.config.mjs",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@base-ui/react": "1.7.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@xyflow/react": "^12.11.6",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "^8.3.0"
  }
}
